# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# NUNCA subas el archivo .env a GitHub.

# ── LLM — Cerebro agentivo (Anthropic, tool use nativo) ───
# El bucle agentivo usa el SDK de Anthropic directamente.
ANTHROPIC_API_KEY=          # platform.anthropic.com/settings/api-keys
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── LLM — Embeddings y resúmenes (vía LiteLLM) ────────────
# Se usa para generar resúmenes de memoria de largo plazo.
# Formato proveedor/modelo (anthropic/..., openai/..., groq/..., etc.)
LLM_MODEL=anthropic/claude-sonnet-4-6
# LLM_API_KEY: alias legacy; si no hay ANTHROPIC_API_KEY se usa como tal.
# LLM_API_KEY=

# ── Multi-tenant ───────────────────────────────────────────
# Tenant por defecto para la ruta legacy /webhook.
# La ruta /webhook/{canal}/{tenant_id} resuelve el tenant desde la URL.
DEFAULT_TENANT_ID=demo

# ── Proveedor de WhatsApp (canal legacy /webhook) ─────────
# Opciones: meta | twilio
WHATSAPP_PROVIDER=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
# META_APP_SECRET=

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_VALIDATE_SIGNATURE=true

# ── Telegram (canal: telegram) ────────────────────────────
# Webhook: POST /webhook/telegram/{tenant_id}
# TELEGRAM_BOT_TOKEN=            # token de @BotFather
# TELEGRAM_WEBHOOK_SECRET=       # secreto aleatorio para validar el webhook
# TELEGRAM_WEBHOOK_URL=          # URL pública; si está, se registra el webhook al arrancar

# ── Discord (canal: discord) ──────────────────────────────
# Webhook (Interactions): POST /webhook/discord/{tenant_id}
# DISCORD_BOT_TOKEN=            # token del bot
# DISCORD_PUBLIC_KEY=           # Public Key de la app (para validar firma Ed25519)

# ── Slack (canal: slack) ──────────────────────────────────
# Webhook (Events API): POST /webhook/slack/{tenant_id}
# SLACK_BOT_TOKEN=             # xoxb-... token del bot
# SLACK_SIGNING_SECRET=        # para validar la firma de los eventos

# ── Email (canal: email) ──────────────────────────────────
# Entrada por polling IMAP, salida por SMTP. Se activa si el tenant lista
# "email" en sus canales (config/tenants/{id}/tenant.yaml) y hay IMAP configurado.
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=
# EMAIL_IMAP_PASSWORD=
# EMAIL_CHECK_INTERVAL_SECONDS=30
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# ── Admin API (panel REST /admin/*) ───────────────────────
ADMIN_ENABLED=true
ADMIN_API_KEY=            # clave para autenticar requests al /admin/* (header X-Admin-Key)

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Producción: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Memoria vectorial (ChromaDB) ──────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
# Modelo de embeddings: "text-embedding-3-small" (OpenAI vía LiteLLM) u otro.
# Usá "local" para embeddings deterministas sin red (offline / pruebas).
EMBEDDING_MODEL=text-embedding-3-small
