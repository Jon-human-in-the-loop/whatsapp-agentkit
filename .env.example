# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# NUNCA subas el archivo .env a GitHub.

# ── LLM — Modelo de lenguaje ──────────────────────────────
# Formato: proveedor/modelo
# Ejemplos:
#   anthropic/claude-sonnet-4-6
#   openai/gpt-4o
#   openai/gpt-4o-mini
#   groq/llama-3.3-70b-versatile
#   gemini/gemini-2.0-flash
#   deepseek/deepseek-chat
#   xai/grok-beta
LLM_MODEL=anthropic/claude-sonnet-4-6

# API key del proveedor elegido en LLM_MODEL:
#   Anthropic  → platform.anthropic.com/settings/api-keys
#   OpenAI     → platform.openai.com/api-keys
#   Groq       → console.groq.com/keys
#   Google     → aistudio.google.com/app/apikey
#   DeepSeek   → platform.deepseek.com
#   xAI        → console.x.ai
LLM_API_KEY=

# ── Multi-tenant ───────────────────────────────────────────
# Tenant por defecto para la ruta legacy /webhook.
# La ruta /webhook/{canal}/{tenant_id} resuelve el tenant desde la URL.
DEFAULT_TENANT_ID=demo

# ── Proveedor de WhatsApp (canal legacy /webhook) ─────────
# Opciones: meta | twilio
WHATSAPP_PROVIDER=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
# META_APP_SECRET=

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_VALIDATE_SIGNATURE=true

# ── Telegram (canal: telegram) ────────────────────────────
# Webhook: POST /webhook/telegram/{tenant_id}
# TELEGRAM_BOT_TOKEN=            # token de @BotFather
# TELEGRAM_WEBHOOK_SECRET=       # secreto aleatorio para validar el webhook
# TELEGRAM_WEBHOOK_URL=          # URL pública; si está, se registra el webhook al arrancar

# ── Discord (canal: discord) ──────────────────────────────
# Webhook (Interactions): POST /webhook/discord/{tenant_id}
# DISCORD_BOT_TOKEN=            # token del bot
# DISCORD_PUBLIC_KEY=           # Public Key de la app (para validar firma Ed25519)

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Producción: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
